<?xml version="1.0"?>
<robot name="arctos" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="hardware_plugin" default="gz_ros2_control/GazeboSimSystem" />
  <xacro:include filename="$(find arctos_control)/urdf/controlled.urdf.xacro" />
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/arctos/sim_joint_states</topic>
    </plugin>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arctos_control)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
