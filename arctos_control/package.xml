<?xml version="1.0"?>
<package format="3">
  <name>arctos_control</name>
  <version>0.1.0</version>
  <description>Shared control configuration and backend contract for Arctos.</description>
  <maintainer email="frank_otto@hotmail.com">Frank Otto</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>arctos_description</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
