<?xml version="1.0"?>
<robot name="arctos">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0" />
  </group>
  <group_state name="home" group="arm">
    <joint name="X_joint" value="0" />
    <joint name="Y_joint" value="0" />
    <joint name="Z_joint" value="0" />
    <joint name="A_joint" value="0" />
    <joint name="B_joint" value="0" />
    <joint name="C_joint" value="0" />
  </group_state>
  <group_state name="demo" group="arm">
    <joint name="X_joint" value="0.4" />
    <joint name="Y_joint" value="0.2" />
    <joint name="Z_joint" value="-0.3" />
    <joint name="A_joint" value="0.2" />
    <joint name="B_joint" value="0.3" />
    <joint name="C_joint" value="-0.2" />
  </group_state>
  <!-- The URDF already owns world_joint. Exclude only adjacent geometry. -->
  <disable_collisions link1="base_link" link2="Link_1_1" reason="Adjacent" />
  <disable_collisions link1="Link_1_1" link2="Link_2_1" reason="Adjacent" />
  <disable_collisions link1="Link_2_1" link2="Link_3_1" reason="Adjacent" />
  <disable_collisions link1="Link_3_1" link2="Link_4_1" reason="Adjacent" />
  <disable_collisions link1="Link_4_1" link2="Link_5_1" reason="Adjacent" />
  <disable_collisions link1="Link_5_1" link2="Link_6_1" reason="Adjacent" />
</robot>
