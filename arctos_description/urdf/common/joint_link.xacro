<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arctos">

  <xacro:property name="arctos_joint_limits"
    value="${xacro.load_yaml('$(find arctos_description)/config/physical_joint_limits.yaml')}" />

  <!-- Define arctos_link macro -->
  <xacro:macro name="arctos_link"
    params="name origin_xyz origin_rpy material_name inertia_origin_xyz inertia_origin_rpy mass ixx iyy izz ixy iyz ixz prefix:=''">
    <link name="${prefix}${name}">
      <visual>
        <origin xyz="${origin_xyz}" rpy="${origin_rpy}" />
        <geometry>
          <mesh filename="package://arctos_description/meshes/${name}.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="${material_name}" />
      </visual>
      <collision>
        <origin xyz="${origin_xyz}" rpy="${origin_rpy}" />
        <geometry>
          <mesh filename="package://arctos_description/meshes/${name}.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${inertia_origin_xyz}" rpy="${inertia_origin_rpy}" />
        <mass value="${mass}" />
        <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}" ixy="${ixy}" iyz="${iyz}" ixz="${ixz}" />
      </inertial>
    </link>
  </xacro:macro>

  <!-- Geometry only: ROS control belongs in a backend wrapper. Damping is a
       modest numerical regularization (N m s/rad), not measured gear friction. -->
  <xacro:macro name="arctos_joint"
    params="name parent child origin_xyz origin_rpy axis_xyz prefix:='' damping:=0.1">
    <xacro:property name="limits" value="${arctos_joint_limits[name]}" />
    <joint name="${prefix}${name}" type="revolute">
      <parent link="${prefix}${parent}" />
      <child link="${prefix}${child}" />
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}" />
      <axis xyz="${axis_xyz}" />
      <limit upper="${limits['upper']}" lower="${limits['lower']}"
        effort="${limits['effort']}" velocity="${limits['velocity']}" />
      <dynamics damping="${damping}" friction="0.0" />
    </joint>
  </xacro:macro>

</robot>
