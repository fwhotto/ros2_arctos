<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Manufacturer ROS geometry: CAD pose is open; each jaw closes 15 mm.
       Right jaw mimics the left along the opposing axis. Units are metres.
       Velocity/effort are simulation estimates, not servo specifications. -->
  <xacro:macro name="arctos_gripper" params="prefix:=''">
    <xacro:arctos_link name="Gripper_1" prefix="${prefix}"
      origin_xyz="0 0.323 -0.5685" origin_rpy="0 0 0" material_name="white"
      inertia_origin_xyz="-0.001 -0.0211 0" inertia_origin_rpy="0 0 0"
      mass="0.2" ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" iyz="0" ixz="0" />
    <!-- Reference jaw properties translated into the existing mesh frame. -->
    <xacro:arctos_link name="Left_jaw_1" prefix="${prefix}"
      origin_xyz="0 0.323 -0.5685" origin_rpy="0 0 0" material_name="white"
      inertia_origin_xyz="-0.003208702480352 -0.046537440309285 0.021981207372214"
      inertia_origin_rpy="0 0 0" mass="0.073696025658594"
      ixx="0.000011" iyy="0.000006" izz="0.000014" ixy="0.000002" iyz="0" ixz="0" />
    <xacro:arctos_link name="Right_jaw_1" prefix="${prefix}"
      origin_xyz="0 0.323 -0.5685" origin_rpy="0 0 0" material_name="white"
      inertia_origin_xyz="-0.000355104952973 -0.046613535307719 -0.019237488097284"
      inertia_origin_rpy="0 0 0" mass="0.073129021687195"
      ixx="0.000011" iyy="0.000006" izz="0.000014" ixy="-0.000001" iyz="0" ixz="-0.000001" />
    <joint name="${prefix}Gripper_joint" type="fixed">
      <parent link="${prefix}tool0" /><child link="${prefix}Gripper_1" />
    </joint>
    <!-- Mesh-derived pad centre. +Z points out of the fingers (-Y in tool0),
         +Y is the closing axis. Provisional until measured on the actual kit. -->
    <link name="${prefix}grasp_frame" />
    <joint name="${prefix}grasp_frame_joint" type="fixed">
      <parent link="${prefix}tool0" /><child link="${prefix}grasp_frame" />
      <origin xyz="-0.00129 -0.074 0.001367" rpy="${pi/2} 0 0" />
    </joint>
    <joint name="${prefix}Left_jaw_joint" type="prismatic">
      <parent link="${prefix}Gripper_1" /><child link="${prefix}Left_jaw_1" />
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.015" velocity="0.02" effort="20" />
      <dynamics damping="0.1" friction="0" />
    </joint>
    <joint name="${prefix}Right_jaw_joint" type="prismatic">
      <parent link="${prefix}Gripper_1" /><child link="${prefix}Right_jaw_1" />
      <axis xyz="0 0 1" />
      <limit lower="0" upper="0.015" velocity="0.02" effort="20" />
      <mimic joint="${prefix}Left_jaw_joint" multiplier="1" offset="0" />
      <dynamics damping="0.1" friction="0" />
    </joint>
  </xacro:macro>
</robot>
