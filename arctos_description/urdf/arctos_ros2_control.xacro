<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Legacy hardware adapter only. Uses the same physical bounds as geometry. -->
  <xacro:include filename="$(find arctos_description)/urdf/common/joint_link.xacro" />
  <xacro:macro name="arctos_hardware_joint" params="name prefix">
    <xacro:property name="limits" value="${arctos_joint_limits[name]}" />
    <joint name="${prefix}${name}">
      <command_interface name="position">
        <param name="min">${limits['lower']}</param>
        <param name="max">${limits['upper']}</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </xacro:macro>
  <xacro:macro name="arctos_ros2_control" params="name prefix:='' include_wrist:=true">
    <ros2_control name="${prefix}${name}" type="system">
      <hardware><plugin>arctos_interface/ArctosInterface</plugin></hardware>
      <xacro:arctos_hardware_joint name="X_joint" prefix="${prefix}" />
      <xacro:arctos_hardware_joint name="Y_joint" prefix="${prefix}" />
      <xacro:arctos_hardware_joint name="Z_joint" prefix="${prefix}" />
      <xacro:if value="${include_wrist}">
        <xacro:arctos_hardware_joint name="A_joint" prefix="${prefix}" />
        <xacro:arctos_hardware_joint name="B_joint" prefix="${prefix}" />
        <xacro:arctos_hardware_joint name="C_joint" prefix="${prefix}" />
      </xacro:if>
    </ros2_control>
  </xacro:macro>
</robot>
