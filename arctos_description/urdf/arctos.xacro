<?xml version="1.0"?>
<robot name="arctos" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="include_gripper" default="false" />
  <xacro:arg name="use_hardware" default="false" />
  <xacro:include filename="$(find arctos_description)/urdf/arctos_arm.xacro" />

  <link name="world" />
  <joint name="$(arg prefix)world_joint" type="fixed">
    <parent link="world" />
    <child link="$(arg prefix)base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <xacro:arctos_arm prefix="$(arg prefix)" include_gripper="$(arg include_gripper)" />

  <!-- Explicit legacy opt-in, not part of the Gazebo path. Jazzy hardware is
       unvalidated. Mock/Gazebo control wrappers are supplied by later gates. -->
  <xacro:if value="$(arg use_hardware)">
    <xacro:include filename="$(find arctos_description)/urdf/arctos_ros2_control.xacro" />
    <xacro:arctos_ros2_control name="arctos_interface" prefix="$(arg prefix)" />
  </xacro:if>
</robot>
