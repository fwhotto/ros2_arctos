<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Preserve the old three-joint macro entry point without duplicating limits. -->
  <xacro:include filename="$(find arctos_description)/urdf/arctos_ros2_control.xacro" ns="full_arm" />
  <xacro:macro name="arctos_ros2_control" params="name prefix:=''">
    <xacro:full_arm.arctos_ros2_control name="${name}" prefix="${prefix}" include_wrist="false" />
  </xacro:macro>
</robot>
